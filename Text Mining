# Importing additional sentimen analysis packages
from nltk.sentiment import SentimentIntensityAnalyzer
# from nltk.classify import NaiveBayesClassifier

# Download NLTK resources
nltk.download('vader_lexicon')

# Initialize the Vader sentiment analyzer
sia = SentimentIntensityAnalyzer()

# Apply sentiment analysis and add scores to the DataFrame
notes['sentiment_score'] = notes['full_note'].apply(lambda x: sia.polarity_scores(x)['compound'])
notes['sentiment_category'] = notes['sentiment_score'].apply(lambda x: 'positive' if x >= 0 else 'negative')

