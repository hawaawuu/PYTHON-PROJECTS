# Function to lemmatize list of strings
# Returns list of lists of tokens
def lemmatize_list(data):
    wnl = WordNetLemmatizer()
    lemma_list = []

    for i in data:
        txt = i
        lemmatized = [wnl.lemmatize(i,j[0].lower()) if j[0].lower() in ['a','n','v','r'] else wnl.lemmatize(i) for i,j in pos_tag(word_tokenize(txt))]
        lemma_list.append(lemmatized)

    return lemma_list


# Uses "list comprehension" to accept list of lists of tokens
# Returns list of lists of tokens, lowercased and lemmatized
def remove_punc(texts):
    return [[word.lower() for word in doc if word.isalpha()] for doc in texts]


# Accepts list of lists of tokens
# Returns same list without stop words
def remove_stopwords(texts):
    return [[word for word in doc if word not in stop_eng] for doc in texts]

